{
  "name": "amaran-light",
  "version": "0.0.1",
  "description": "Control Amaran 150c light via Bluetooth",
  "main": "dist/index.js",
  "bin": {
    "amaran": "./dist/index.js"
  },
  "scripts": {
    "setup": "tsx src/setup.ts",
    "daemon:start": "tsx src/daemon.ts",
    "daemon:stop": "tsx src/cli.ts stop",
    "mqtt:start": "tsx src/mqtt-bridge.ts",
    "amaran": "tsx src/cli.ts",
    "mesh:on": "tsx src/cli.ts on",
    "mesh:off": "tsx src/cli.ts off",
    "mesh:brightness": "tsx src/cli.ts brightness",
    "mesh:cct": "tsx src/cli.ts cct",
    "mesh:hsi": "tsx src/cli.ts hsi",
    "scan": "tsx src/ble-scanner.ts scan",
    "discover": "tsx src/ble-scanner.ts connect",
    "py:on": "/opt/homebrew/bin/python3.11 src/pymesh-controller.py on",
    "py:off": "/opt/homebrew/bin/python3.11 src/pymesh-controller.py off",
    "py:brightness": "/opt/homebrew/bin/python3.11 src/pymesh-controller.py brightness",
    "py:cct": "/opt/homebrew/bin/python3.11 src/pymesh-controller.py cct",
    "build": "tsc"
  },
  "keywords": [
    "amaran",
    "aputure",
    "bluetooth",
    "ble",
    "light",
    "control"
  ],
  "author": "Wes Bos (https://wesbos.com/)",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@abandonware/noble": "^1.9.2-26",
    "mqtt": "^5.15.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
